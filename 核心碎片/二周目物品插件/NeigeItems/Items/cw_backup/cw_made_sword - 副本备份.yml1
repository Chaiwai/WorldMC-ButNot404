    锻造显示:
      type: join
      list:
        - "<锻造属性.<锻造品质>.词条1.名称>：<锻造属性.<锻造品质>.<锻造属性.<锻造品质>.词条1.名称>>%"
        - "<锻造属性.<锻造品质>.词条2.名称>：<锻造属性.<锻造品质>.<锻造属性.<锻造品质>.词条2.名称>>%"
        - "<锻造属性.<锻造品质>.词条3.名称>：<锻造属性.<锻造品质>.<锻造属性.<锻造品质>.词条3.名称>>%"
        - "<锻造属性.<锻造品质>.词条4.名称>：<锻造属性.<锻造品质>.<锻造属性.<锻造品质>.词条4.名称>>%"
        - "<锻造属性.<锻造品质>.词条5.名称>：<锻造属性.<锻造品质>.<锻造属性.<锻造品质>.词条5.名称>>%"
        - "<锻造属性.<锻造品质>.词条6.名称>：<锻造属性.<锻造品质>.<锻造属性.<锻造品质>.词条6.名称>>%"
      separator: "\\n&r&7"
      limit: <锻造属性.<锻造品质>.前缀数量>
      prefix: '"&r&7'
      postfix: '"'

    锻造代码:
      type: join
      list:
        - "<锻造属性.<锻造品质>.词条1.代码>"
        - "<锻造属性.<锻造品质>.词条2.代码>"
        - "<锻造属性.<锻造品质>.词条3.代码>"
        - "<锻造属性.<锻造品质>.词条4.代码>"
      separator: "\\n"
      limit: <锻造属性.<锻造品质>.前缀数量>
      # prefix: '"&r&7'
      # postfix: '"'
    #原版
    物品名称: "泰拉棱镜"
    物品贴图: 10063
    物品材质: "netherite_sword"
    物品简介: "这是一把刀111"
    #Mi
    Mi_GP: "DAGGER"
    Mi_ID: "TEST1"
    基础_攻击伤害: 10
    基础_暴击几率: 30
    基础_暴击增伤: 0
    基础_横扫增伤: 0

    基础_攻击速度: 1.6
    基础_攻击距离: 3
    #mi额外
    额外_攻击伤害: <锻造属性.<锻造品质>.伤害>
    额外_暴击几率: <锻造属性.<锻造品质>.暴击>
    额外_暴击增伤: <number::0_3>
    额外_横扫增伤: <number::0_3>

    额外_攻击速度: <锻造属性.<锻造品质>.攻速>
    额外_攻击距离: <锻造属性.<锻造品质>.大小>

    灵魂绑定: "<papi::player_name>"
