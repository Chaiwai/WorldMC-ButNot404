cw_sword_tem:
  name: "&r&f<物品名称>"
  material: <物品材质>
  components:
    minecraft:custom_model_data:
      floats:
        - (Float) <物品贴图>
    minecraft:attribute_modifiers:
      show_in_tooltip: (Byte) 0
      modifiers:
        - amount: (Double) 0.0
          id: mmoitems:decoy
          type: minecraft:attack_speed
          operation: add_value
        - amount: (Double) 10.0
          id: minecraft:attack_knockback
          type: minecraft:attack_knockback
          operation: add_value

  options:
    update:
      enable: true
      refresh:
        - material
        - lore
      protect-components:
        - minecraft:custom_name
        - components.minecraft:enchantments
  globalsections:
    - Diablo.yml
  lore:
    - "&r&f   "
    - "&r&f"
    - "&r&f  <物品简介>"
    - "&r&f   "
    - "&r&f"
    - "&r&f  伤害: &f<基础_攻击伤害>&7(&7<额外_攻击伤害>%&7)"
    - "&r&f  攻速: &f<基础_攻击速度>&7(&7<额外_攻击速度>%&7)"
    - "&r&f  暴击: &f<基础_暴击几率>&7(&7<额外_暴击几率>%&7)"
    # - "&r&f  爆伤: &f<基础_暴击增伤>&7(&7<额外_暴击增伤>%&7)"
    # - "&r&f  横扫: &f<基础_横扫增伤>&7(&7<额外_横扫增伤>%&7)"
    - "&r&f  大小: &f<基础_攻击距离>&7(&7<额外_攻击距离>%&7)"
    - "&r&f   "
    - "&r&f"
    - "&r&f锻造品质: <锻造品质>"
    - "<锻造显示>"
    - "&r&f  灵魂绑定: <灵魂绑定>"
  nbt:
    PublicBukkitValues:
      itemsoulbind:soulbinduuid: <灵魂绑定>
    #mi
    MMOITEMS_ITEM_TYPE: <Mi_GP> #必要!!
    MMOITEMS_ITEM_ID: <Mi_ID> #必要!!
    MMOITEMS_ATTACK_DAMAGE: (Double) <fastcalc::<基础_攻击伤害>*(1+0.01*<额外_攻击伤害>)_4>
    MMOITEMS_CRITICAL_STRIKE_CHANCE: (Double) <fastcalc::<基础_暴击几率>*(1+0.01*<额外_暴击几率>)_4>
    MMOITEMS_CRITICAL_STRIKE_POWER: (Double) <fastcalc::<基础_暴击增伤>*(1+0.01*<额外_暴击增伤>)_4>
    MMOITEMS_BLUNT_RATING: (Double) <fastcalc::<基础_横扫增伤>*(1+0.01*<额外_横扫增伤>)_4>
    MMOITEMS_ATTACK_SPEED: (Double) <fastcalc::<基础_攻击速度>*(1+0.01*<额外_攻击速度>)_4>
    MMOITEMS_ENTITY_INTERACTION_RANGE: (Double) <fastcalc::<基础_攻击距离>*(1+0.01*<额外_攻击距离>)-3_4>

cw_s0_0:
  inherit: cw_sword_tem
  sections:
    name: "天顶剑"
    datapack: 10155
    p_uuid: "<papi::player_uuid>"
    p_name: "<papi::player_name>"
    #类型
    equipmentType: "主手"
    type: "剑"
    level: "无情"
    text: "没有简介"
    att_attack: "2" #物理伤害

cw_s0_1:
  inherit: cw_sword_tem
  sections:
    锻造品质:
      type: weight
