title: "&0&l护甲的意义"

events:
  post_open:
    - command "ply set %player_name% page 38 开启菜单" as console
    - context set player@menu_page to 38
    - icon by "护甲槽" update
    - icon by "模板槽" update
    - icon by "宝石槽" update
    - sound entity.villager.ambient by 100 2
  close: sound entity.villager.yes by 100 2

layout: |-
  |      |
  |`模板槽`    `头盔_模板``头盔``头盔_镶嵌`
  |  `护甲槽`  `胸甲_模板``胸甲``胸甲_镶嵌`
  |`宝石槽`    `裤腿_模板``裤腿``裤腿_镶嵌`
  |     `靴子_模板``靴子``靴子_镶嵌`
  |      |

items:
  "头盔":
    name: "当前装备"
    material: "%checkitem_getinfo:39_mat:%"
    customModelData: "%checkitem_getinfo:39_custommodeldata:%"
    sub:
      - rule: check papi "%ni_data_get_39_id%" != "护甲"
        material: barrier
    action:
      - command "ply set %player_name% page 39" as console
      - context set player@menu_page to 39
      - icon by "护甲槽" update
      - icon by "模板槽" update
      - icon by "宝石槽" update
  "胸甲":
    name: "当前装备"
    material: "%checkitem_getinfo:38_mat:%"
    customModelData: "%checkitem_getinfo:38_custommodeldata:%"
    sub:
      - rule: check papi "%ni_data_get_38_id%" != "护甲"
        material: barrier
    action:
      - command "ply set %player_name% page 38" as console
      - context set player@menu_page to 38
      - icon by "护甲槽" update
      - icon by "模板槽" update
      - icon by "宝石槽" update
  "裤腿":
    name: "当前装备"
    material: "%checkitem_getinfo:37_mat:%"
    customModelData: "%checkitem_getinfo:37_custommodeldata:%"
    sub:
      - rule: check papi "%ni_data_get_37_id%" != "护甲"
        material: barrier
    action:
      - command "ply set %player_name% page 37" as console
      - context set player@menu_page to 37
      - icon by "护甲槽" update
      - icon by "模板槽" update
      - icon by "宝石槽" update
  "靴子":
    name: "当前装备"
    material: "%checkitem_getinfo:36_mat:%"
    customModelData: "%checkitem_getinfo:36_custommodeldata:%"
    lore:
      - "%ni_data_get_36_id%"
    sub:
      - rule: check papi "%ni_data_get_36_id%" != "护甲"
        material: barrier
    action:
      - command "ply set %player_name% page 36" as console
      - context set player@menu_page to 36
      - icon by "护甲槽" update
      - icon by "模板槽" update
      - icon by "宝石槽" update

  "头盔_模板":
    name: "当前模板"
    material: "%ni_data_get_39_盔甲纹饰.模板%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_39_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f
  "胸甲_模板":
    name: "当前模板"
    material: "%ni_data_get_38_盔甲纹饰.模板%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_38_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f
