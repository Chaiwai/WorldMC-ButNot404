    name: "当前模板"
    material: "%ni_data_get_37_盔甲纹饰.模板%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_37_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f
  "靴子_模板":
    name: "当前模板"
    material: "%ni_data_get_36_盔甲纹饰.模板%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_36_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f

  "头盔_镶嵌":
    name: "当前镶嵌"
    material: "%ni_data_get_39_盔甲纹饰.镶嵌%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_39_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f
  "胸甲_镶嵌":
    name: "当前镶嵌"
    material: "%ni_data_get_38_盔甲纹饰.镶嵌%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_38_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f
  "裤腿_镶嵌":
    name: "当前镶嵌"
    material: "%ni_data_get_37_盔甲纹饰.镶嵌%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_37_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f
  "靴子_镶嵌":
    name: "当前镶嵌"
    material: "%ni_data_get_36_盔甲纹饰.镶嵌%"
    lore: |-
      &r&F
      &r&F&d>>  &e当前镶嵌  &d<<
      &r&F
    sub:
      - rule: check papi "%ni_data_get_36_id%" != "护甲"
        ia: cancel
        lore: |-
          &r&f
          &r&f&c这里还什么都没有....
          &r&f
  "护甲槽":
    name: "护甲槽, %playercurrency_page%   aaa%checkitem_getinfo:{math_0_36+{{context get player@menu_page}}}_mat:%"
    material: "%checkitem_getinfo:{{context get player@menu_page}}_mat:%"
    customModelData: "%checkitem_getinfo:{{context get player@menu_page}}_custommodeldata:%"
    action:
      - icon by "护甲槽" update
      - icon by "模板槽" update
      - icon by "宝石槽" update
  "模板槽":
    name: "护甲槽"
    material: "%ni_data_get_{{context get player@menu_page}}_盔甲纹饰.模板%"
    action:
      catch: input_text
      cancel: ["cancel"]
      beforeInput: |
        tell "&a请将需要修改的"
        tell "&b随后聊天栏输入需要去除的附魔"
        tell "&7输入 &f'cancel' &c来取消操作(不返还金币)"
      afterInput:
        sleep 0.1s
        # command "ni editSlot me {{context get player@menu_page}} rebuild {"盔甲纹饰.模板":"%checkitem_getinfo:mainhand_mat:%"}" as op
        tell '{{context get player@menu_page}}'
        tell "ni editSlot me {{context get player@menu_page}} rebuild {"盔甲纹饰.模板":"%checkitem_getinfo:mainhand_mat:%"}"
        icon by "护甲槽" update
        icon by "模板槽" update
        icon by "宝石槽" update
        # menu close
      onCancel: |
        title "&c你已取消当前操作" subtitle pass
      onRepeat: |
        tell "?"
  "宝石槽":
    name: "宝石槽"
    material: "%ni_data_get_{{context get player@menu_page}}_盔甲纹饰.镶嵌%"
    action:
      - icon by "护甲槽" update
      - icon by "模板槽" update
      - icon by "宝石槽" update
# %ni_data_get_{math_0_36+{{context get player@menu_page}}}_盔甲纹饰.模板%
